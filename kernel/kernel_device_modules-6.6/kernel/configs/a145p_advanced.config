# A145P advanced feature bundle (v1.1)
#
# Applied on top of mediatek-bazel_defconfig + mt6768_overlay.config + o22.config.
# Every option is built-in (=y) on purpose: the release package does not ship
# .ko files, so a =m option would silently be unavailable on the device.
#
# Keep this fragment free of options that change exported GKI structure
# layouts or the KMI symbol list; the stock /vendor modules must keep loading.

# --- nftables (modern firewall / transparent proxy rules) ---
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_ARP=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NFT_NAT=y
CONFIG_NFT_TPROXY=y

# --- traffic shaping (SQM / low latency) ---
CONFIG_NET_SCH_CAKE=y

# --- container / Droidspaces networking ---
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_VXLAN=y

# --- tethering and packet mangling helpers ---
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_IP6_NF_TARGET_HL=y
CONFIG_NETFILTER_XT_MATCH_CONNLABEL=y
CONFIG_NETFILTER_XT_MATCH_CPU=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y

# --- read-only compressed images (KernelSU modules, container roots) ---
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_ZSTD=y

# --- network filesystems ---
CONFIG_NFS_FS=y
CONFIG_NFS_V4=y
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y
CONFIG_CIFS=y

# --- USB serial adapters (Arduino, 3D printers, LTE modems) ---
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_PL2303=y
CONFIG_USB_SERIAL_OPTION=y

# --- input ---
CONFIG_INPUT_JOYDEV=y

# --- memory / hardening ---
# KSM is compiled in but stays inactive until userspace sets
# /sys/kernel/mm/ksm/run = 1, so there is no idle CPU cost by default.
CONFIG_KSM=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
