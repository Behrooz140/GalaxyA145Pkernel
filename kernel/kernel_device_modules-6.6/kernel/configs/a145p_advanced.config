# A145P advanced feature bundle (v1.2)
#
# Applied on top of mediatek-bazel_defconfig + mt6768_overlay.config + o22.config.
# Options are built-in (=y) on purpose: the release package does not ship .ko
# files, so a =m option would silently be unavailable on the device. USB serial
# is the exception and stays =m exactly like the stock firmware.
#
# KMI RULE (v1.1 bootlooped because of this):
# The kernel keeps CONFIG_MODVERSIONS=y, so every exported symbol carries a CRC
# computed by genksyms from the types in its signature - including the full
# definition of referenced structs. Changing the layout of a struct that is used
# by exported functions changes ~10k CRCs, including module_layout, and then ALL
# stock modules in /vendor refuse to load. Never enable options that alter
# exported GKI structures. Known breakers (do NOT re-add):
#
#   CONFIG_NF_TABLES* / CONFIG_NFT_*
#       struct net (adds .nft), netns_nf (adds .hooks_bridge)
#   CONFIG_NETFILTER_XT_MATCH_CONNLABEL
#       selects NF_CONNTRACK_LABELS -> netns_ct.labels_used and
#       NF_CT_EXT_NUM 5 -> 6 (u8 offset[] grows inside struct nf_ct_ext)
#   CONFIG_KSM
#       struct mm_struct KSM counters, struct vm_event_state
#   CONFIG_VXLAN
#       selects NET_L3_MASTER_DEV -> net_device.l3mdev_ops, netns_ipv4 sysctls
#   CONFIG_IPVLAN
#       IPVLAN_L3S is "def_bool y" (no prompt) and also selects
#       NET_L3_MASTER_DEV, so IPVLAN cannot be enabled either.
#
# Note: =m does not help, because these options are guarded by IS_ENABLED() or
# pulled in by "select". Only disabling them restores the ABI.
#
# scripts/kmi_check.py + configs/kmi-baseline-v1.0.txt enforce this in CI: the
# build fails if any exported symbol CRC differs from v1.0 or disappears.

# --- traffic shaping (SQM / low latency) ---
CONFIG_NET_SCH_CAKE=y

# --- container / Droidspaces networking ---
# MACVLAN only. It does not touch any exported structure.
CONFIG_MACVLAN=y

# --- tethering and packet mangling helpers ---
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_IP6_NF_TARGET_HL=y
CONFIG_NETFILTER_XT_MATCH_CPU=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y

# --- read-only compressed images (KernelSU modules, container roots) ---
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_ZSTD=y

# --- network filesystems ---
CONFIG_NFS_FS=y
CONFIG_NFS_V4=y
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y
CONFIG_CIFS=y

# --- USB serial ---
# Stock value is =m and v1.0 booted with it, so keep it untouched. The .ko
# files are not part of the release, therefore the adapters are not usable
# unless a future package ships modules (workflow input include_modules=true).
CONFIG_USB_SERIAL=m

# --- input ---
CONFIG_INPUT_JOYDEV=y

# --- memory / hardening ---
# KSM is intentionally absent: it changes struct mm_struct and vm_event_state.
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
